  "$defs": {
    "publicationManifest": {
      "type": "object",
      "required": [
        "schema",
        "non_authorizing",
        "files",
        "private_sources",
        "record_sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "iicp.assessment-publication-manifest.v1"
        },
        "non_authorizing": {
          "const": true
        },
        "files": {
          "type": "object",
          "required": [
            "assessments.json"
          ],
          "additionalProperties": false,
          "properties": {
            "assessments.json": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "private_sources": {
          "type": "string"
        },
        "record_sha256": {
          "type": "object",
          "minProperties": 68,
          "maxProperties": 68,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
